#!/usr/bin/env bash
# netmeter-setup: configure the statusLine block in ~/.claude/settings.json
# so the netmeter statusline appears.
#
# Usage:
#   netmeter-setup            apply (compose with existing statusline if any)
#   netmeter-setup --dry-run  preview what would change, write nothing
#   netmeter-setup --replace  throw away the existing statusline (no compose)
#   netmeter-setup --help     show this help
#
# Behaviour:
#   - No existing statusLine            → install netmeter alone.
#   - Existing statusLine                → compose: keep the user's line(s) AS
#                                          THE FIRST ROWS and append netmeter
#                                          on a row below. The user never has
#                                          to merge scripts by hand.
#   - --replace                          → discard the existing one, netmeter only.
#
# Safety guarantees:
#   - Refuses to run if netmeter@toolbelt isn't installed.
#   - Always writes a timestamped backup of settings.json before any change.
#   - Atomic write: settings.json is never half-written.
#   - Idempotent: re-running detects "already configured" and exits cleanly.
#
# Anything goes wrong? Run netmeter-teardown to restore the most recent backup.

set -uo pipefail

DRY_RUN=0
REPLACE=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --replace|--force) REPLACE=1 ;;
    --help|-h)
      sed -n '2,/^$/p' "$0" | sed 's/^# //; s/^#//'
      exit 0
      ;;
    *)
      echo "netmeter-setup: unknown argument: $arg" >&2
      echo "Try: netmeter-setup --help" >&2
      exit 2
      ;;
  esac
done

INSTALLED="$HOME/.claude/plugins/installed_plugins.json"
SETTINGS="$HOME/.claude/settings.json"

# 1. Plugin must be installed.
if [ ! -f "$INSTALLED" ] || ! grep -q '"netmeter@toolbelt"' "$INSTALLED"; then
  cat >&2 <<EOF
netmeter-setup: netmeter@toolbelt is not installed.

Install it first in Claude Code:
  /plugin marketplace add nagavineerpasam/netmeter
  /plugin install netmeter@toolbelt

Then re-run netmeter-setup.
EOF
  exit 1
fi

# 2. Look up the actual install path (version-stable: reads what's installed now).
INSTALL_PATH="$(python3 - <<EOF
import json
try:
    d = json.load(open("$INSTALLED"))
    entries = d.get("plugins", {}).get("netmeter@toolbelt", [])
    print(entries[0]["installPath"] if entries else "")
except Exception:
    print("")
EOF
)"
if [ -z "$INSTALL_PATH" ] || [ ! -x "$INSTALL_PATH/statusline.sh" ]; then
  echo "netmeter-setup: could not resolve install path for netmeter@toolbelt." >&2
  echo "Try reinstalling: /plugin install netmeter@toolbelt" >&2
  exit 1
fi
STATUSLINE_CMD="$INSTALL_PATH/statusline.sh"

# 3. Inspect any existing statusLine.
CURRENT_CMD="$(python3 - <<EOF
import json
try:
    s = json.load(open("$SETTINGS"))
    print(s.get("statusLine", {}).get("command", ""))
except Exception:
    print("")
EOF
)"

# 4. Decide what to do.
ACTION=""
if [ "$CURRENT_CMD" = "$STATUSLINE_CMD" ]; then
  echo "netmeter-setup: statusLine is already pointing at netmeter."
  echo "  command: $STATUSLINE_CMD"
  echo "Nothing to do."
  exit 0
elif [ -z "$CURRENT_CMD" ]; then
  ACTION="add"
elif [ "$REPLACE" = "1" ]; then
  ACTION="replace"
else
  ACTION="compose"
fi

# 5. Dry run: report what would happen, then exit without writing.
if [ "$DRY_RUN" = "1" ]; then
  echo "DRY RUN — netmeter-setup would make these changes:"
  echo
  echo "  1. Back up $SETTINGS to:"
  echo "       $SETTINGS.bak.netmeter-<timestamp>"
  echo
  case "$ACTION" in
    add)
      echo "  2. Add a fresh statusLine block (netmeter only):"
      cat <<EOF
       {
         "statusLine": {
           "type": "command",
           "command": "$STATUSLINE_CMD",
           "padding": 0,
           "refreshInterval": 5
         }
       }
EOF
      ;;
    compose)
      echo "  2. Detected an existing statusLine — composing rather than"
      echo "     replacing. Your existing line stays as the TOP row, netmeter"
      echo "     appears on the row below it."
      echo
      echo "     current statusLine.command:"
      echo "       $CURRENT_CMD"
      echo
      echo "     after netmeter-setup:"
      cat <<EOF
       statusLine.command  =  $STATUSLINE_CMD
       compose-with file   =  $HOME/.claude/plugins/data/netmeter/compose_with
                              (contains: $CURRENT_CMD)
EOF
      echo
      echo "  (Pass --replace if you'd rather throw away the existing statusline.)"
      ;;
    replace)
      echo "  2. Replace the existing statusLine (current command: $CURRENT_CMD) with:"
      cat <<EOF
       {
         "statusLine": {
           "type": "command",
           "command": "$STATUSLINE_CMD",
           "padding": 0,
           "refreshInterval": 5
         }
       }
EOF
      ;;
  esac
  echo
  echo "Re-run without --dry-run to apply."
  exit 0
fi

# 6. Backup.
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP="$SETTINGS.bak.netmeter-$TIMESTAMP"
if [ -f "$SETTINGS" ]; then
  cp "$SETTINGS" "$BACKUP" || {
    echo "netmeter-setup: failed to write backup at $BACKUP" >&2
    exit 4
  }
else
  echo '{}' > "$BACKUP"
fi

# 7. Apply atomically.
#    - settings.json: replace statusLine.command with netmeter's wrapper.
#    - data/netmeter/compose_with: write the previous command for the
#      wrapper to invoke. (statusLine.env is not honoured by Claude Code,
#      so we use a file instead. The file path is stable across plugin
#      updates because it lives in the data dir, not the cache dir.)
COMPOSE_DIR="$HOME/.claude/plugins/data/netmeter"
COMPOSE_FILE="$COMPOSE_DIR/compose_with"
mkdir -p "$COMPOSE_DIR"

if [ "$ACTION" = "compose" ] && [ -n "$CURRENT_CMD" ]; then
  printf '%s\n' "$CURRENT_CMD" > "$COMPOSE_FILE.tmp" && mv "$COMPOSE_FILE.tmp" "$COMPOSE_FILE"
else
  rm -f "$COMPOSE_FILE"
fi

ACTION="$ACTION" CURRENT_CMD="$CURRENT_CMD" STATUSLINE_CMD="$STATUSLINE_CMD" \
SETTINGS="$SETTINGS" python3 - <<'PYEOF' || { echo "netmeter-setup: failed to update settings" >&2; exit 5; }
import json, os
path = os.environ["SETTINGS"]
new_cmd = os.environ["STATUSLINE_CMD"]

try:
    with open(path) as f:
        s = json.load(f)
except FileNotFoundError:
    s = {}

existing = s.get("statusLine", {})
new_block = {
    "type": "command",
    "command": new_cmd,
    "padding": existing.get("padding", 0),
    "refreshInterval": existing.get("refreshInterval", 5),
}
# Preserve any non-NETMETER env the user had (e.g. NETMETER_FORMAT).
env = {k: v for k, v in existing.get("env", {}).items()
       if k != "NETMETER_COMPOSE_WITH"}
if env:
    new_block["env"] = env

s["statusLine"] = new_block

tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(s, f, indent=2)
os.rename(tmp, path)
PYEOF

echo "netmeter-setup: done."
echo
echo "  Action:   ${ACTION}"
echo "  Command:  $STATUSLINE_CMD"
if [ "$ACTION" = "compose" ]; then
  echo "  Composed: $CURRENT_CMD"
fi
echo "  Backup:   $BACKUP"
echo
case "$ACTION" in
  compose)
    echo "Your previous statusline is preserved as the top row;"
    echo "netmeter shows on the row below it. Settings reload"
    echo "automatically — your next message refreshes the statusline."
    ;;
  *)
    echo "Settings reload automatically — your next message refreshes"
    echo "the statusline."
    ;;
esac
echo
echo "If anything looks wrong, run netmeter-teardown to restore the backup."
