#!/usr/bin/env bash
# netmeter-setup: configure (or preview) the statusLine block in
# ~/.claude/settings.json so the netmeter statusline actually appears.
#
# Usage:
#   netmeter-setup            apply (with safety checks)
#   netmeter-setup --dry-run  preview what would change, write nothing
#   netmeter-setup --force    replace an existing custom statusLine
#   netmeter-setup --help     show this help
#
# Safety guarantees:
#   - Refuses to run if netmeter@toolbelt isn't installed.
#   - Refuses to overwrite an existing non-netmeter statusLine unless --force.
#   - Always writes a timestamped backup of settings.json before any change.
#   - Atomic write: settings.json is never half-written.
#   - Idempotent: re-running detects "already configured" and exits cleanly.
#
# Anything goes wrong? Run netmeter-teardown to restore the most recent backup.

set -uo pipefail

DRY_RUN=0
FORCE=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --force)   FORCE=1 ;;
    --help|-h)
      sed -n '2,/^$/p' "$0" | sed 's/^# //; s/^#//'
      exit 0
      ;;
    *)
      echo "netmeter-setup: unknown argument: $arg" >&2
      echo "Try: netmeter-setup --help" >&2
      exit 2
      ;;
  esac
done

INSTALLED="$HOME/.claude/plugins/installed_plugins.json"
SETTINGS="$HOME/.claude/settings.json"

# 1. Plugin must be installed.
if [ ! -f "$INSTALLED" ] || ! grep -q '"netmeter@toolbelt"' "$INSTALLED"; then
  cat >&2 <<EOF
netmeter-setup: netmeter@toolbelt is not installed.

Install it first in Claude Code:
  /plugin marketplace add nagavineerpasam/netmeter
  /plugin install netmeter@toolbelt

Then re-run netmeter-setup.
EOF
  exit 1
fi

# 2. Look up the actual install path (version-stable: reads what's installed now).
INSTALL_PATH="$(python3 - <<EOF
import json, sys
try:
    d = json.load(open("$INSTALLED"))
    entries = d.get("plugins", {}).get("netmeter@toolbelt", [])
    print(entries[0]["installPath"] if entries else "")
except Exception:
    print("")
EOF
)"
if [ -z "$INSTALL_PATH" ] || [ ! -x "$INSTALL_PATH/statusline.sh" ]; then
  echo "netmeter-setup: could not resolve install path for netmeter@toolbelt." >&2
  echo "Try reinstalling: /plugin install netmeter@toolbelt" >&2
  exit 1
fi
STATUSLINE_CMD="$INSTALL_PATH/statusline.sh"

# 3. Inspect any existing statusLine.
CURRENT_CMD="$(python3 - <<EOF
import json
try:
    s = json.load(open("$SETTINGS"))
    print(s.get("statusLine", {}).get("command", ""))
except Exception:
    print("")
EOF
)"

# 4. Decide what to do.
ACTION=""
if [ -z "$CURRENT_CMD" ]; then
  ACTION="add"
elif [ "$CURRENT_CMD" = "$STATUSLINE_CMD" ]; then
  echo "netmeter-setup: statusLine is already configured for netmeter."
  echo "  command: $STATUSLINE_CMD"
  echo "Nothing to do. Restart Claude Code if you don't yet see the statusline."
  exit 0
elif [ "$FORCE" = "1" ]; then
  ACTION="replace"
else
  cat >&2 <<EOF
netmeter-setup: you already have a different statusLine configured.

  current: $CURRENT_CMD
  netmeter: $STATUSLINE_CMD

Refusing to overwrite without --force.

To replace it, re-run:
  netmeter-setup --force

Your existing statusLine will be backed up alongside settings.json so
you can restore it with netmeter-teardown.
EOF
  exit 3
fi

# 5. Dry run: report what would happen, then exit without writing.
if [ "$DRY_RUN" = "1" ]; then
  echo "DRY RUN — netmeter-setup would make these changes:"
  echo
  echo "  1. Back up $SETTINGS to:"
  echo "       $SETTINGS.bak.netmeter-<timestamp>"
  echo
  case "$ACTION" in
    add)
      echo "  2. Add a statusLine block to $SETTINGS:"
      ;;
    replace)
      echo "  2. Replace the existing statusLine in $SETTINGS"
      echo "     (current: $CURRENT_CMD)"
      echo "     with:"
      ;;
  esac
  cat <<EOF
       {
         "statusLine": {
           "type": "command",
           "command": "$STATUSLINE_CMD",
           "padding": 0,
           "refreshInterval": 5
         }
       }
EOF
  echo
  echo "Re-run without --dry-run to apply."
  exit 0
fi

# 6. Backup.
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP="$SETTINGS.bak.netmeter-$TIMESTAMP"
if [ -f "$SETTINGS" ]; then
  cp "$SETTINGS" "$BACKUP" || {
    echo "netmeter-setup: failed to write backup at $BACKUP" >&2
    exit 4
  }
else
  echo '{}' > "$BACKUP"
fi

# 7. Apply atomically.
python3 - <<EOF || { echo "netmeter-setup: failed to update settings" >&2; exit 5; }
import json, os
path = "$SETTINGS"
try:
    with open(path) as f:
        s = json.load(f)
except FileNotFoundError:
    s = {}
s["statusLine"] = {
    "type": "command",
    "command": "$STATUSLINE_CMD",
    "padding": 0,
    "refreshInterval": 5,
}
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(s, f, indent=2)
os.rename(tmp, path)
EOF

echo "netmeter-setup: done."
echo
echo "  Action:   ${ACTION}"
echo "  Command:  $STATUSLINE_CMD"
echo "  Backup:   $BACKUP"
echo
echo "Restart Claude Code (/exit and then run 'claude' again) to see the statusline."
echo "If anything looks wrong, run netmeter-teardown to restore the backup."
